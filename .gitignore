# ---- secrets ----
.env
.env.*
!.env.example
# The OAuth client JSON Google hands out on download. It carries the client
# secret in plain text, so it must never reach a commit.
client_secret*.json
*credentials*.json

# ---- python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- virtual environments ----
.venv/
venv/

# ---- conda / anaconda artefacts ----
.conda/
conda-meta/
envs/
*.conda
*.tar.bz2
environment.local.yml

# ---- notebooks ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.spyproject/
.spyderproject/
.ropeproject/

# ---- os ----
.DS_Store
Thumbs.db
desktop.ini

# ---- local PostgreSQL cluster (scripts/README create this; never commit it) ----
.pgdata/
# and any cluster kept aside during a version upgrade
.pgdata-*/
logfile

# ---- never commit a local database or logs; the Render disk is ephemeral ----
*.sqlite
*.sqlite3
*.db
*.log
logs/

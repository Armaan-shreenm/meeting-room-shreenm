# =============================================================================
# NM Meet — environment template.
# Copy to .env for local development. Never commit .env. No real values here.
# On Render every key below is set in the Blueprint or the dashboard.
# =============================================================================

# ---- runtime -----------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
# Port uvicorn binds to. Render injects this; locally it defaults to 8000.
PORT=8000
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Echo every SQL statement to stdout. Never enable in production.
SQL_ECHO=false

# ---- database ----------------------------------------------------------------
# Render injects DATABASE_URL with a "postgres://" scheme; config.py rewrites it
# to "postgresql+psycopg2://" before SQLAlchemy sees it. Both forms are accepted.
# PostgreSQL only — the no_double_booking EXCLUDE constraint requires it.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nm_meet
# Connection pool. Render's managed Postgres drops idle connections, so they are
# recycled before it does. One worker on the free plan needs very little.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# ---- who is booking -----------------------------------------------------------
# NM Meet asks for no sign-in: whoever the form names as host owns the booking,
# and there is no login page. The session, CSRF and "only the booker may cancel"
# rules are all built and tested behind this switch - turn it on the day Google
# Sign-In is activated and they come back with no code change.
#
# With it off, anybody who can reach the app can cancel anybody's booking.
SIGN_IN_REQUIRED=false

# ---- Google Sign-In -----------------------------------------------------------
# The backend is complete. The login page shows the button only once these are
# set. Create an OAuth client in the Google Cloud console (type: Web), and
# register GOOGLE_REDIRECT_URI there exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Only this domain may sign in. A personal gmail account is refused by name.
ALLOWED_EMAIL_DOMAIN=shreenm.com
# Create a directory entry on somebody's first Google sign-in.
GOOGLE_AUTO_CREATE_USERS=true

# ---- authentication -----------------------------------------------------------
# Signs the session cookie. Generate a real one for anything but a laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the shipped default.
SECRET_KEY=dev-only-not-a-secret-change-me
# How long a sign-in lasts. 43200 = one working day.
SESSION_MAX_AGE_SECONDS=43200
# bcrypt cost. Higher is slower and safer; 12 is a sensible 2026 default.
BCRYPT_ROUNDS=12
# Password given to every account scripts/seed.py creates. Leave blank and each
# account gets its own random one, printed once to stdout and stored only hashed.
SEED_PASSWORD=
# Whether the seed creates the ten demo directory members. Off by default, and
# that is a security decision: those accounts have PASSWORDS, and password login
# still works alongside Google. Seeding them into a real deployment would let
# anybody holding one in without ever touching Google or the domain check.
# Real people are created by Google Sign-In, with no password at all.
# Turn it on locally to run the test suite, which needs a populated directory.
SEED_DEMO_USERS=false

# ---- branch / locale ---------------------------------------------------------
# All timestamps are stored as timestamptz in UTC and displayed in this zone.
TZ=Asia/Kolkata
BRANCH_NAME=Mumbai

# ---- booking rules (spec sections 3, 4 and the settled section 13 decisions) --
# Earliest bookable time, local branch time.
OPEN_TIME=10:00
# Latest a booking may end, local branch time.
CLOSE_TIME=19:00
# Clock granularity. D-07 settled at 30 minutes.
SLOT_MINUTES=30
# Shortest permitted booking.
MIN_BOOKING_MINUTES=30
# Longest single booking; four hours.
MAX_BOOKING_MINUTES=240
# How far ahead the date picker may go.
# Booking window, counting today. 7 = today and the next six days.
MAX_ADVANCE_DAYS=7
# D-06: unused room released by reception after this many minutes.
NO_SHOW_RELEASE_MINUTES=15
# JSON list, Monday=0 ... Sunday=6. D-03: Monday to Saturday working, Sunday closed.
CLOSED_WEEKDAYS=[6]
# Spec field 8: title defaults to this when left blank.
DEFAULT_MEETING_TITLE=Meeting

# ---- notifications ------------------------------------------------------------
# Master switch. With it off, or with SMTP_HOST empty, every message is written
# to stdout instead - recorded, not lost.
NOTIFICATIONS_ENABLED=false
# Gmail / Google Workspace: smtp.gmail.com on 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
# The mailbox the mail is sent FROM and authenticated AS. Gmail rejects a From
# address that is neither the account nor one of its verified aliases.
SMTP_USER=
# A Google **app password**, not the account password, and not with the spaces
# Google displays it with. Never commit this file with a value here.
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=nm-meet@example.invalid
SMTP_FROM_NAME=NM Meet
# The Mumbai front desk mailbox (spec section 8).
RECEPTION_EMAIL=reception.mumbai@shreenm.com
# The branch-wide distribution list (spec section 8), told about every booking
# the moment it is made. Reception books on behalf of people who are not on the
# booking, so without this nobody outside the front desk hears that a room has
# gone. Empty means the branch is not written to at all.
MUMBAI_GROUP_EMAIL=mumbai.all@shreenm.com
# Base URL used to build the "view or cancel this booking" link in every message.
PUBLIC_BASE_URL=http://localhost:8000
# D-02: attach an .ics calendar invite; no Google Meet link is created.
CALENDAR_INVITE_ENABLED=true

# ---- hardening ----------------------------------------------------------------
# Booking writes allowed per signed-in user per window. Reads are never limited:
# the grid polls availability every minute.
RATE_LIMIT_BOOKINGS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ---- cors --------------------------------------------------------------------
# JSON list. Unused in production: the API and the frontend share one origin.
CORS_ORIGINS=["*"]
